# ===============================================
# OUTFIT COURT - BACKEND ENVIRONMENT VARIABLES
# ===============================================

# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Anthropic Claude API (Analyzes outfit photos & crafts judge dialogue)
# Keep strictly on the server, never expose to frontend
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxx
AI_MODEL=claude-3-5-sonnet-20241022
MOCK_AI=true # Set false when valid ANTHROPIC_API_KEY is supplied

# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Security & Sessions
SESSION_SECRET=super_secret_court_key_change_in_production
COOKIE_DOMAIN=localhost

# Storage & Upload Limits
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=8
AUTO_DELETE_PHOTOS_DAYS=30

# Rate Limiting
RATE_LIMIT_TRIALS_PER_HOUR=10
RATE_LIMIT_GENERAL_PER_MINUTE=100
